# Copia este archivo a .env.deploy y llénalo con los datos de tu servidor.
# .env.deploy está en .gitignore: nunca subas los datos reales.
TAC_SSH_TARGET=usuario@tu-servidor.com
TAC_SSH_PORT=22
TAC_SSH_KEY="$HOME/.ssh/id_ed25519"
# Carpeta de WordPress, relativa al home del usuario SSH
TAC_WP_DIR=public_html
